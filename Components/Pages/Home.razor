@page "/"
@using System.Globalization
@using System.IO
@using System.Runtime.InteropServices
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MauiPdfPrinter.Services
@using MauiPdfPrinter.Platforms.Windows
@inject IJSRuntime JS
@inject IPrintService PrintService
@implements IAsyncDisposable

<PageTitle>PDF Print</PageTitle>

<main class="app-shell">
    <header class="toolbar">
        <button class="button button-open open-button" @onclick="OpenPdfAsync" disabled="@_busy">
            @if (_busy)
            {
                <span class="spinner" aria-hidden="true"></span>
                <span>@T("正在打开…", "Opening…")</span>
            }
            else
            {
                <span class="button-icon" aria-hidden="true">＋</span>
                <span>@T("打开文件", "Open file")</span>
            }
        </button>

        <div class="document-name" title="@_fileName">
            @if (_hasDocument)
            {
                <span class="file-type-icon" aria-hidden="true">PDF</span>
                <span class="file-name">@_fileName</span>
                <span class="document-pages">@_pageCount @T("页", "pages")</span>
            }
            else
            {
                <span class="document-placeholder">@T("未打开文档", "No document open")</span>
            }
        </div>

        <div class="toolbar-actions">
            @if (_hasDocument)
            {
                <div class="zoom-actions">
                    <button class="icon-button" title="@T("缩小", "Zoom out")" aria-label="@T("缩小", "Zoom out")" @onclick="() => ChangeZoomAsync(-0.1)" disabled="@_busy">−</button>
                    <span class="zoom-value">@($"{_zoom:P0}")</span>
                    <button class="icon-button" title="@T("放大", "Zoom in")" aria-label="@T("放大", "Zoom in")" @onclick="() => ChangeZoomAsync(0.1)" disabled="@_busy">+</button>
                </div>
                <span class="toolbar-divider"></span>
                <div class="page-navigation">
                    <span class="page-count">@_currentPage / @_pageCount</span>
                    <button class="icon-button" title="@T("上一页", "Previous page")" aria-label="@T("上一页", "Previous page")" @onclick="() => NavigatePageAsync(-1)" disabled="@(_currentPage <= 1 || _busy)">‹</button>
                    <button class="icon-button" title="@T("下一页", "Next page")" aria-label="@T("下一页", "Next page")" @onclick="() => NavigatePageAsync(1)" disabled="@(_currentPage >= _pageCount || _busy)">›</button>
                </div>
            }

        </div>
    </header>

    @if (_error is not null)
    {
        <div class="error-card" role="alert">
            <span class="error-icon" aria-hidden="true">!</span>
            <span>@_error</span>
            <button class="error-dismiss" title="@T("关闭", "Dismiss")" aria-label="@T("关闭", "Dismiss")" @onclick="() => _error = null">×</button>
        </div>
    }

    <section class="preview-section" aria-label="@T("PDF 预览", "PDF preview")">
        <div class="preview-scroll">
            <div id="pdf-pages" class="pdf-pages"></div>
        </div>

        @if (!_hasDocument && !_busy)
        {
            <div class="welcome-card">
                <div class="welcome-art" aria-hidden="true">
                    <div class="art-sheet art-sheet-back"></div>
                    <div class="art-sheet art-sheet-front">
                        <span class="art-pdf">PDF</span>
                        <span class="art-line art-line-long"></span>
                        <span class="art-line"></span>
                        <span class="art-line art-line-short"></span>
                    </div>
                </div>
                <button class="button button-secondary" @onclick="OpenPdfAsync">@T("选择 PDF 文件", "Choose a PDF")</button>
            </div>
        }

            <aside class="print-panel" aria-label="@T("打印设置", "Print settings")">
                <h2>@T("打印设置", "Print settings")</h2>
                <label>
                    @T("打印机", "Printer")
                    <select value="@_selectedPrinter" @onchange="OnPrinterChanged">
                        @foreach (var printer in _printers)
                        {
                            <option value="@printer.Name">@printer.Name</option>
                        }
                    </select>
                </label>
                <label>
                    @T("份数", "Copies")
                    <input type="number" min="1" max="999" @bind="_copies" @bind:event="oninput" />
                </label>
                <label>
                    @T("打印范围（如 5-6，留空为全部）", "Page range (e.g. 5-6, blank = all)")
                    <input type="text" placeholder="@(_hasDocument ? $"1-{_pageCount}" : "")" @bind="_pageRange" @bind:event="oninput" />
                </label>
                @if (PageRangeError is not null)
                {
                    <span class="print-note" role="alert">@PageRangeError</span>
                }
                <label>
                    @T("纸张大小", "Paper size")
                    <select value="@_paper" @onchange="OnPaperChanged">
                        <option value="auto">@T("自动（打印机默认 / 与 PDF 页相同）", "Auto (printer default / same as PDF)")</option>
                        @foreach (var paper in Papers)
                        {
                            <option value="@paper.Key">@paper.Value.Label</option>
                        }
                    </select>
                </label>
                <label>
                    @T("打印质量", "Print quality")
                    <select value="@_quality" @onchange="OnQualityChanged">
                        <option value="draft">@T("草稿（最快，100 dpi）", "Draft (fastest, 100 dpi)")</option>
                        <option value="standard">@T("标准（150 dpi）", "Standard (150 dpi)")</option>
                        <option value="high">@T("高（220 dpi）", "High (220 dpi)")</option>
                        <option value="best">@T("最佳（300 dpi）", "Best (300 dpi)")</option>
                        <option value="ultra">@T("超高（最慢，600 dpi）", "Ultra (slowest, 600 dpi)")</option>
                    </select>
                </label>
                <label>
                    @T("颜色", "Color")
                    <select value="@(_color ? "color" : "mono")" @onchange="OnColorChanged">
                        <option value="color">@T("彩色", "Color")</option>
                        <option value="mono">@T("黑白", "Black and white")</option>
                    </select>
                </label>
                <label>
                    @T("单双面", "Sides")
                    <select value="@_duplex" @onchange="OnDuplexChanged" disabled="@(SelectedPrinterInfo?.SupportsDuplex != true)">
                        <option value="@DuplexMode.Simplex">@T("单面", "One-sided")</option>
                        @if (SelectedPrinterInfo?.SupportsDuplex == true)
                        {
                            <option value="@DuplexMode.LongEdge">@T("双面（长边翻转）", "Two-sided (flip on long edge)")</option>
                            <option value="@DuplexMode.ShortEdge">@T("双面（短边翻转）", "Two-sided (flip on short edge)")</option>
                        }
                    </select>
                </label>
                @if (SelectedPrinterInfo is { SupportsDuplex: false })
                {
                    <span class="print-note">@T("所选打印机不支持双面打印。", "The selected printer does not support duplex printing.")</span>
                }
                <div class="print-panel-actions">
                    @if (_printing)
                    {
                        <div class="print-busy" role="status" aria-live="polite">
                            <span class="spinner spinner-dark" aria-hidden="true"></span>
                            <span>@PrintBusyMessage</span>
                        </div>
                    }
                    <button class="button button-print" @onclick="PrintAsync" disabled="@(SelectedPrinterInfo is null || !_hasDocument || _busy || _printing)">@T("打印", "Print")</button>

                </div>
            </aside>

        @if (_busy)
        {
            <div class="busy-overlay" aria-live="polite">
                <span class="spinner spinner-dark" aria-hidden="true"></span>
                <span>@BusyMessage</span>
            </div>
        }
    </section>

    <footer class="status-bar">
        <span>作者：张芷梮</span>
        <a href="mailto:weny917920@gmial.com">email: weny917920@gmial.com</a>
    </footer>
</main>

@code {
    private const long MaximumPdfSize = 128L * 1024 * 1024;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Home>? _dotNetReference;
    private bool _busy;
    private bool _printing;
    private int _printTotal;
    private bool _preparingPrintPreview;
    private int _printProgress;
    private string _paper = "auto";
    private string _quality = "standard";
    private static readonly Dictionary<string, (string Label, double Width, double Height)> Papers = new()
    {
        ["A3"] = ("A3", 11.693, 16.535),
        ["A4"] = ("A4", 8.268, 11.693),
        ["A5"] = ("A5", 5.827, 8.268),
        ["B5"] = ("B5", 6.929, 9.843),
        ["Letter"] = ("Letter", 8.5, 11),
        ["Legal"] = ("Legal", 8.5, 14)
    };
    private string? _pageRange;
    private bool _color = true;
    private int _copies = 1;
    private DuplexMode _duplex = DuplexMode.Simplex;
    private string? _selectedPrinter;
    private IReadOnlyList<PrinterInfo> _printers = [];
    private bool _hasDocument;
    private string? _fileName;
    private string? _error;
    private int _pageCount;
    private int _currentPage = 1;
    private double _zoom = 1;
    private bool _previewReady;
    private bool _processingActivatedFiles;
    private readonly Queue<string> _activatedFilePaths = new();
    private bool IsChinese => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("zh", StringComparison.OrdinalIgnoreCase);

    private string T(string chinese, string english) => IsChinese ? chinese : english;
    private string PrintBusyMessage => _preparingPrintPreview
        ? T($"正在准备 {_printProgress}/{_printTotal} 页…", $"Preparing {_printProgress}/{_printTotal}…")
        : T("正在打印…", "Printing…");
    private string BusyMessage => T("正在准备文档…", "Preparing document…");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        LoadPrinters();
        await EnsurePreviewModuleAsync();
        _previewReady = _module is not null;
        while (PdfFileActivation.TryTakePendingPath(out var path))
        {
            _activatedFilePaths.Enqueue(path);
        }
        await ProcessActivatedFilesAsync();
        await InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        PdfFileActivation.FileActivated += OnPdfFileActivated;
    }

    private void OnPdfFileActivated(string path)
    {
        _ = InvokeAsync(async () =>
        {
            _activatedFilePaths.Enqueue(path);
            await ProcessActivatedFilesAsync();
        });
    }

    private async Task ProcessActivatedFilesAsync()
    {
        if (!_previewReady || _busy || _printing || _processingActivatedFiles)
        {
            return;
        }

        _processingActivatedFiles = true;
        try
        {
            while (!_busy && !_printing && _activatedFilePaths.TryDequeue(out var path))
            {
                await OpenActivatedFileAsync(path);
            }
        }
        finally
        {
            _processingActivatedFiles = false;
        }
    }

    private async Task OpenActivatedFileAsync(string path)
    {
        _busy = true;
        _error = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var fileName = Path.GetFileName(path);
            if (!Path.GetExtension(fileName).Equals(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                _error = T("请选择扩展名为 .pdf 的文件。", "Please choose a file with the .pdf extension.");
                return;
            }

            await EnsurePreviewModuleAsync();
            if (_module is null)
            {
                return;
            }

            await using var stream = File.OpenRead(path);
            await LoadPdfAsync(stream, fileName);
        }
        catch (JSException exception)
        {
            _error = T($"文件不是有效的 PDF，或文档已损坏。{Environment.NewLine}{exception.Message}", $"This PDF is invalid or damaged.{Environment.NewLine}{exception.Message}");
        }
        catch (IOException exception)
        {
            _error = T($"无法读取所选文件：{exception.Message}", $"Could not read the selected file: {exception.Message}");
        }
        catch (PdfTooLargeException)
        {
            _error = T("文件超过 128 MB。请先压缩 PDF 后再打开。", "The file is larger than 128 MB. Compress the PDF and try again.");
        }
        catch (UnauthorizedAccessException)
        {
            _error = T("没有权限读取所选文件。请检查文件权限后重试。", "You do not have permission to read this file. Check its permissions and try again.");
        }
        catch (InvalidOperationException exception)
        {
            _error = T($"当前操作暂不可用：{exception.Message}", $"This operation is not available right now: {exception.Message}");
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EnsurePreviewModuleAsync()
    {
        if (_module is not null)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pdf-preview.js");
            _dotNetReference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("initialize", IsChinese ? "zh-CN" : "en-US", _dotNetReference);
        }
        catch (JSException exception)
        {
            _error = T($"PDF 预览模块未能加载：{exception.Message}", $"The PDF preview module could not be loaded: {exception.Message}");
        }
        catch (InvalidOperationException exception)
        {
            _error = T($"PDF 预览暂时不可用：{exception.Message}", $"PDF preview is temporarily unavailable: {exception.Message}");
        }
    }

    private async Task OpenPdfAsync()
    {
        if (_busy || _printing)
        {
            return;
        }

        _busy = true;
        _error = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var fileType = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                [DevicePlatform.WinUI] = [".pdf"]
            });
            var file = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = T("选择要预览的 PDF 文件", "Choose a PDF to preview"),
                FileTypes = fileType
            });

            if (file is null)
            {
                return;
            }

            if (!Path.GetExtension(file.FileName).Equals(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                _error = T("请选择扩展名为 .pdf 的文件。", "Please choose a file with the .pdf extension.");
                return;
            }

            await EnsurePreviewModuleAsync();
            if (_module is null)
            {
                return;
            }

            await using var stream = await file.OpenReadAsync();
            await LoadPdfAsync(stream, file.FileName);
        }
        catch (JSException exception)
        {
            _error = T($"文件不是有效的 PDF，或文档已损坏。{Environment.NewLine}{exception.Message}", $"This PDF is invalid or damaged.{Environment.NewLine}{exception.Message}");
        }
        catch (IOException exception)
        {
            _error = T($"无法读取所选文件：{exception.Message}", $"Could not read the selected file: {exception.Message}");
        }
        catch (PdfTooLargeException)
        {
            _error = T("文件超过 128 MB。请先压缩 PDF 后再打开。", "The file is larger than 128 MB. Compress the PDF and try again.");
        }
        catch (UnauthorizedAccessException)
        {
            _error = T("没有权限读取所选文件。请检查文件权限后重试。", "You do not have permission to read this file. Check its permissions and try again.");
        }
        catch (InvalidOperationException exception)
        {
            _error = T($"当前操作暂不可用：{exception.Message}", $"This operation is not available right now: {exception.Message}");
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
            await ProcessActivatedFilesAsync();
        }
    }

    private async Task LoadPdfAsync(Stream source, string fileName)
    {
        await EnsurePreviewModuleAsync();
        if (_module is null)
        {
            return;
        }

        var pdfBytes = await ReadPdfBytesAsync(source);
        await using var pdfStream = new MemoryStream(pdfBytes, writable: false);
        using var streamReference = new DotNetStreamReference(pdfStream, leaveOpen: true);
        var result = await _module.InvokeAsync<LoadResult>("load", streamReference);
        _fileName = fileName;
        _pageCount = result.PageCount;
        _currentPage = 1;
        _hasDocument = true;
        _zoom = 1;
    }

    private static async Task<byte[]> ReadPdfBytesAsync(Stream source)
    {
        if (source.CanSeek && source.Length > MaximumPdfSize)
        {
            throw new PdfTooLargeException();
        }

        using var buffer = new MemoryStream();
        var chunk = new byte[81920];
        int bytesRead;
        while ((bytesRead = await source.ReadAsync(chunk)) > 0)
        {
            if (buffer.Length + bytesRead > MaximumPdfSize)
            {
                throw new PdfTooLargeException();
            }

            await buffer.WriteAsync(chunk.AsMemory(0, bytesRead));
        }

        return buffer.ToArray();
    }

    private void LoadPrinters()
    {
        try
        {
            _printers = PrintService.GetPrinters();
        }
        catch (Exception exception) when (exception is COMException or InvalidOperationException)
        {
            _printers = [];
            _error = T($"无法读取打印机列表：{exception.Message}", $"Could not read the printer list: {exception.Message}");
        }

        if (_printers.All(p => p.Name != _selectedPrinter))
        {
            _selectedPrinter = (_printers.FirstOrDefault(p => p.IsDefault) ?? _printers.FirstOrDefault())?.Name;
        }

        NormalizeDuplex();
    }

    private string? PageRangeError { get; set; }

    private static bool TryNormalizeRange(string? text, int pageCount, out string? normalized)
    {
        normalized = null;
        if (string.IsNullOrWhiteSpace(text))
        {
            return true;
        }

        var parts = new List<string>();
        foreach (var raw in text.Replace('，', ',').Replace('－', '-').Replace('–', '-').Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var bounds = raw.Split('-', StringSplitOptions.TrimEntries);
            if (bounds.Length is < 1 or > 2 || !int.TryParse(bounds[0], out var start) || start < 1 || start > pageCount)
            {
                return false;
            }

            var end = start;
            if (bounds.Length == 2 && (!int.TryParse(bounds[1], out end) || end < start || end > pageCount))
            {
                return false;
            }

            parts.Add(start == end ? $"{start}" : $"{start}-{end}");
        }

        normalized = parts.Count == 0 ? null : string.Join(",", parts);
        return parts.Count > 0;
    }
    private PrinterInfo? SelectedPrinterInfo => _printers.FirstOrDefault(p => p.Name == _selectedPrinter);

    private void OnPrinterChanged(ChangeEventArgs args)
    {
        _selectedPrinter = args.Value?.ToString();
        NormalizeDuplex();
    }

    private void NormalizeDuplex()
    {
        if (SelectedPrinterInfo?.SupportsDuplex != true)
        {
            _duplex = DuplexMode.Simplex;
        }
    }

    private void OnQualityChanged(ChangeEventArgs args) => _quality = args.Value?.ToString() ?? "standard";

    private void OnPaperChanged(ChangeEventArgs args) => _paper = args.Value?.ToString() ?? "auto";

    private void OnColorChanged(ChangeEventArgs args) => _color = args.Value?.ToString() != "mono";

    private void OnDuplexChanged(ChangeEventArgs args)
    {
        _duplex = Enum.TryParse<DuplexMode>(args.Value?.ToString(), out var mode) ? mode : DuplexMode.Simplex;
    }

    private async Task PrintAsync()
    {
        if (!_hasDocument || _busy || _printing || _module is null || SelectedPrinterInfo is null)
        {
            return;
        }

        if (!TryNormalizeRange(_pageRange, _pageCount, out var ranges))
        {
            PageRangeError = T($"页码范围无效。请输入 1 到 {_pageCount} 之间的页码，例如 5-6 或 1,3,5-7。", $"Invalid page range. Use pages 1 to {_pageCount}, for example 5-6 or 1,3,5-7.");
            return;
        }

        PageRangeError = null;
        var request = new PrintRequest(SelectedPrinterInfo.Name, Math.Clamp(_copies, 1, 999), _duplex, ranges, _color);
        _printing = true;
        _error = null;
        _preparingPrintPreview = true;
        _printProgress = 0;
        _printTotal = ranges is null ? _pageCount : CountPages(ranges);
        await InvokeAsync(StateHasChanged);

        try
        {
            var pageSize = await _module.InvokeAsync<PageSize?>("preparePrint", !_color, request.PageRanges, _quality);
            request = request with
            {
                PageWidthInches = pageSize?.Width,
                PageHeightInches = pageSize?.Height,
                PaperWidthInches = Papers.TryGetValue(_paper, out var paper) ? paper.Width : null,
                PaperHeightInches = Papers.TryGetValue(_paper, out paper) ? paper.Height : null
            };
            _preparingPrintPreview = false;
            await InvokeAsync(StateHasChanged);
            await PrintService.PrintAsync(request);
        }
        catch (JSException exception)
        {
            _error = T($"准备打印时出错：{exception.Message}", $"Could not prepare printing: {exception.Message}");
        }
        catch (InvalidOperationException exception)
        {
            _error = T($"打印失败：{exception.Message}", $"Printing failed: {exception.Message}");
        }
        catch (COMException exception)
        {
            _error = T($"打印失败：{exception.Message}", $"Printing failed: {exception.Message}");
        }
        finally
        {
            try
            {
                await _module.InvokeVoidAsync("finishPrint");
            }
            catch (JSException)
            {
            }

            _preparingPrintPreview = false;
            _printing = false;
            await InvokeAsync(StateHasChanged);
            await ProcessActivatedFilesAsync();
        }
    }

    private static int CountPages(string ranges) => ranges.Split(",").Sum(part =>
    {
        var bounds = part.Split("-");
        return bounds.Length == 2 ? int.Parse(bounds[1]) - int.Parse(bounds[0]) + 1 : 1;
    });

    [JSInvokable]
    public Task OnPrintProgress(int renderedPages)
    {
        _printProgress = renderedPages;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnPrintDialogClosed() => Task.CompletedTask;
    private async Task ChangeZoomAsync(double amount)
    {
        if (_module is null || !_hasDocument || _busy)
        {
            return;
        }

        _zoom = Math.Clamp(_zoom + amount, 0.5, 1.6);
        await _module.InvokeVoidAsync("setZoom", _zoom);
    }

    private async Task NavigatePageAsync(int amount)
    {
        if (_module is null || !_hasDocument || _busy)
        {
            return;
        }

        _currentPage = Math.Clamp(_currentPage + amount, 1, _pageCount);
        await _module.InvokeVoidAsync("scrollToPage", _currentPage);
    }

    [JSInvokable]
    public Task OnVisiblePageChanged(int pageNumber)
    {
        if (pageNumber >= 1 && pageNumber <= _pageCount && _currentPage != pageNumber)
        {
            _currentPage = pageNumber;
            return InvokeAsync(StateHasChanged);
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        PdfFileActivation.FileActivated -= OnPdfFileActivated;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose");
            await _module.DisposeAsync();
        }

        _dotNetReference?.Dispose();
    }

    private sealed record LoadResult(int PageCount);
    private sealed record PageSize(double Width, double Height);
    private sealed class PdfTooLargeException : Exception
    {
    }
}
